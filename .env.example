# Django
  DJANGO_DEBUG=1
  DJANGO_SECRET_KEY=change-me
  DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

  # Database (PostGIS container)
  POSTGRES_DB=
  POSTGRES_USER=
  POSTGRES_PASSWORD=

  # Corridor around the route (meters)
  CORRIDOR_BASE_METERS=5000
  CORRIDOR_RADIUS_CAP_METERS=10000

  # External providers (free, no API key)
  OSRM_URL=https://router.project-osrm.org
  NOMINATIM_URL=https://nominatim.openstreetmap.org
  EXTERNAL_TIMEOUT_SECONDS=10